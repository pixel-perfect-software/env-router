{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "envrouter-app",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EnvRouter",
        "width": 900,
        "height": 620,
        "minWidth": 680,
        "minHeight": 460,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "section": "devel",
        "recommends": ["gnome-keyring"]
      }
    }
  }
}
