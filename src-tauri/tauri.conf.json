{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnvRouter",
  "version": "0.1.0",
  "identifier": "com.tylerrobertson.envrouter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EnvRouter",
        "width": 900,
        "height": 620,
        "minWidth": 680,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 20 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/envrouter-shim"]
  }
}
