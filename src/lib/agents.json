[
  {
    "command": "claude",
    "label": "Claude Code",
    "mark": "claude",
    "envVar": "CLAUDE_CONFIG_DIR",
    "defaultPath": "~/.claude",
    "install": "curl -fsSL https://claude.ai/install.sh | bash",
    "mcp": {
      "dialect": "claude",
      "configArg": "--mcp-config=",
      "denyArg": "--disallowedTools=",
      "skipAnyArgs": ["--strict-mcp-config"],
      "skipSubcommands": [
        "attach",
        "bridge",
        "daemon",
        "kill",
        "logs",
        "plugin",
        "plugins",
        "rc",
        "remote",
        "remote-control",
        "respawn",
        "rm",
        "self-hosted-runner",
        "stop",
        "sync"
      ],
      "skipIfPresent": ["/Library/Application Support/ClaudeCode/managed-mcp.json", "/etc/claude-code/managed-mcp.json"]
    },
    "mcpFiles": { "userFile": ".claude.json", "defaultDir": "~", "projectFile": ".mcp.json" },
    "ide": {
      "setting": "claudeCode.claudeProcessWrapper",
      "extension": "anthropic.claude-code",
      "note": "With the wrapper set, a tab that doesn't pick a permission mode starts in “default”, not your configured one."
    }
  },
  {
    "command": "copilot",
    "label": "Copilot CLI",
    "mark": "copilot",
    "envVar": "COPILOT_HOME",
    "defaultPath": "~/.copilot",
    "install": "curl -fsSL https://gh.io/copilot-install | bash",
    "mcp": {
      "dialect": "copilot",
      "configArg": "--additional-mcp-config=@",
      "denyArg": "--deny-tool=",
      "skipAnyArgs": [],
      "skipSubcommands": [],
      "skipIfPresent": []
    },
    "mcpFiles": { "userFile": "mcp-config.json", "defaultDir": "~/.copilot", "projectFile": ".mcp.json" }
  }
]
