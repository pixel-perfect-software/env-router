# Generated by env-router's release workflow from packaging/homebrew/envrouter-cli.rb.in.
# Edit the template there, not this file.
class EnvrouterCli < Formula
  desc "Routes each coding agent to the right account and MCP servers by folder"
  homepage "https://github.com/pixel-perfect-software/env-router"
  license "GPL-3.0-or-later"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    # There's no Intel macOS build yet, so an Intel Mac is told so rather than given no URL.
    depends_on arch: :arm64
    on_arm do
      url "https://github.com/pixel-perfect-software/env-router/releases/download/v@VERSION@/envrouter-cli-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_CLI_AARCH64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/pixel-perfect-software/env-router/releases/download/v@VERSION@/envrouter-cli-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_CLI_X86_64_UNKNOWN_LINUX_GNU@"
    end
    on_arm do
      url "https://github.com/pixel-perfect-software/env-router/releases/download/v@VERSION@/envrouter-cli-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_CLI_AARCH64_UNKNOWN_LINUX_GNU@"
    end
  end

  def install
    # The shim, the secrets helper (and on Linux its Windows build, for WSL) stay beside the
    # CLI, which installs them into ~/.envrouter/bin from there.
    libexec.install Dir["*"]
    bin.install_symlink libexec/"envrouter"
  end

  def caveats
    <<~EOS
      Install the shim and helpers into ~/.envrouter, then turn routing on in your shell:
        envrouter install
        envrouter shell on zsh    # or bash, fish
      After upgrading, run `envrouter install` again. On a Mac with the EnvRouter app,
      skip `envrouter install`: the app keeps ~/.envrouter/bin current itself.
      To remove everything, quit the EnvRouter app if it's open and run `envrouter uninstall` (it
      turns routing off, deletes the MCP secrets and ~/.envrouter), then `brew uninstall envrouter-cli`.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/envrouter --version")
  end
end
