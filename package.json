{
  "name": "envrouter",
  "private": true,
  "version": "0.7.1",
  "description": "Per-directory environment routing for developer CLIs",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check-types": "tsc --noEmit",
    "check-deps": "autd check",
    "test": "vitest run",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "notices": "node packaging/notices/render.mjs",
    "bundle": "pnpm notices && tauri build --config src-tauri/tauri.licences.conf.json",
    "update-deps": "autd update"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@pixel-perfect-software/always-up-to-date": "^1.0.31",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}
