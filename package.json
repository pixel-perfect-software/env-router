{
  "name": "envrouter",
  "private": true,
  "version": "0.10.0",
  "description": "Per-directory environment routing for developer CLIs",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check-types": "tsc --noEmit",
    "check-deps": "autd check",
    "test": "vitest run",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "notices": "node packaging/notices/render.mjs",
    "bundle": "pnpm notices && tauri build --config src-tauri/tauri.licences.conf.json",
    "update-deps": "autd update"
  },
  "dependencies": {
    "@tauri-apps/api": "catalog:ui",
    "@tauri-apps/plugin-dialog": "catalog:ui",
    "lucide-react": "catalog:ui",
    "react": "catalog:ui",
    "react-dom": "catalog:ui",
    "simple-icons": "catalog:ui"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@pixel-perfect-software/always-up-to-date": "catalog:dev",
    "@tailwindcss/vite": "catalog:dev",
    "@tauri-apps/cli": "catalog:dev",
    "@testing-library/dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "happy-dom": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  }
}
