# Linux build and test image for EnvRouter: real zsh, bash and fish, a GNOME Keyring for the
# secrets round trip, the WebKitGTK packages the desktop app needs, and mingw-w64 to build the
# Windows secrets helper.
FROM docker.io/library/rust:1-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      zsh fish gnome-keyring dbus libsecret-tools \
      libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev \
      mingw-w64 \
 && rm -rf /var/lib/apt/lists/*

# Node and pnpm, for the desktop app's frontend and `tauri build` (linux-bundle). Keep Node at the
# version in .tool-versions, which is outside this build context.
ARG NODE_VERSION=24.22.1
RUN arch=$(dpkg --print-architecture | sed 's/amd64/x64/') \
 && curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-$arch.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
 && npm install -g --allow-scripts=pnpm pnpm >/dev/null

# cargo-about, for the third-party notices every bundle carries (linux-bundle), at the version CI
# installs.
RUN cargo install --locked --features cli cargo-about@0.9.2

ENV CARGO_TARGET_DIR=/target ENVROUTER_REQUIRE_SHELLS=1
WORKDIR /work
